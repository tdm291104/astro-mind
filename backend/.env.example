# Copy to .env and fill in.

# Core
ANTHROPIC_API_KEY=
JWT_SECRET=                          # >= 32 chars: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_EXPIRE_DAYS=7
COOKIE_SECURE=false                  # set true in production (HTTPS)

# CORS
# CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# OAuth (Google: console.cloud.google.com/apis/credentials | GitHub: github.com/settings/developers)
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin bootstrap
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Models
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5-20251001
EMBED_MODEL=intfloat/multilingual-e5-small
GALAXY_MODEL_PATH=galaxy_morphology_predictor/galaxy_morphology_predictor.keras

# Storage & logging
DATA_DIR=./data
LOG_LEVEL=INFO

# External APIs
NASA_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=
COST_PER_1K_TOKENS=0.0007
